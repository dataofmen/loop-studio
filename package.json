{
  "name": "loop-survey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/db-migrate.mjs && next dev -H 127.0.0.1",
    "build": "next build",
    "start": "node scripts/db-migrate.mjs && next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "personas:build": "uv run --python 3.12 --with pyarrow scripts/build_personas_db.py",
    "population:build": "bun scripts/build_population.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "package": "next build && bun scripts/package-app.ts",
    "app:build": "tauri build",
    "app:dev": "tauri dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@electric-sql/pglite": "^0.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "fflate": "^0.8.3",
    "flint-chart": "^0.2.0",
    "lucide-react": "^1.23.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.4",
    "@astryxdesign/core": "^0.1.4",
    "@astryxdesign/theme-neutral": "^0.1.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.28.1",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
