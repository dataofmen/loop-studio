{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loop Studio",
  "version": "0.1.0",
  "identifier": "io.github.dataofmen.loop-studio",
  "build": {
    "beforeBuildCommand": "bun run package && bun scripts/prepare-sidecar.ts",
    "frontendDist": "../src-tauri/placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../dist/app": "app"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
